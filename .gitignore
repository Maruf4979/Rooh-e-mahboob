# =============================================================
#  ROOT .gitignore — Rooh-e-Mahboob Monorepo
#  Frontend : Next.js  (frontend/.gitignore handles its own)
#  Backend  : Java Spring Boot (Maven)
# =============================================================

# ── Java ──────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# ── Maven ─────────────────────────────────────────────────────
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ── Gradle ────────────────────────────────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ── Spring Boot ───────────────────────────────────────────────
spring-shell.log

# ── IDEs ──────────────────────────────────────────────────────
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/

# VS Code
.vscode/

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ── Environment variables (NEVER commit) ──────────────────────
.env
.env.*
!.env.example
*.env

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Temp / Scratch ────────────────────────────────────────────
scratch/
tmp/

# ── Security ──────────────────────────────────────────────────
*.pem
*.p12
*.jks
*.keystore

# ── Node (root workspace scripts only) ────────────────────────
node_modules/
npm-debug.log*
